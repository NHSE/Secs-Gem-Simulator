&lt;td style=&quot; padding-left:0; padding-right:0; padding-top:7; padding-bottom:11;&quot;&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'AppleSDGothicNeo,Noto Sans KR,sans-serif'; font-size:8pt; color:#666666;&quot;&gt;1~120&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot; padding-left:0; padding-right:0; padding-top:7; padding-bottom:11;&quot;&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'AppleSDGothicNeo,Noto Sans KR,sans-serif'; font-size:8pt; color:#666666;&quot;&gt;T5&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td style=&quot; padding-left:0; padding-right:0; padding-top:7; padding-bottom:11;&quot;&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'AppleSDGothicNeo,Noto Sans KR,sans-serif'; font-size:8pt; color:#000000; background-color:#ffffff;&quot;&gt;Connect Separation Timeout&lt;/span&gt;&lt;span style=&quot; font-family:'AppleSDGothicNeo,Noto Sans KR,sans-serif'; font-size:8pt; color:#666666;&quot;&gt;&lt;br /&gt;&lt;/span&gt;&lt;span style=&quot; font-family:'AppleSDGothicNeo,Noto Sans KR,sans-serif'; font-size:8pt; font-weight:600; color:#666666;&quot;&gt;HSMS&lt;/span&gt;&lt;span style=&quot; font-family:'AppleSDGothicNeo,Noto Sans KR,sans-serif'; font-size:8pt; color:#666666;&quot;&gt; 에서 소켓이 연결된 후 설정된 시간동안 selection handshaking을 진행하고 실패하면 connection을 끊고 재시도하기까지 기다리는 시간&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td style=&quot; padding-left:0; padding-right:0; padding-top:7; padding-bottom:11;&quot;&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'AppleSDGothicNeo,Noto Sans KR,sans-serif'; font-size:8pt; color:#666666;&quot;&gt;10&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td style=&quot; padding-left:0; padding-right:0; padding-top:7; padding-bottom:11;&quot;&gt;
